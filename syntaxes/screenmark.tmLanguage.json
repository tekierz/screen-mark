{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "ScreenMark",
  "scopeName": "text.screenmark",
  "patterns": [
    {
      "include": "#document-start"
    },
    {
      "include": "#comment"
    },
    {
      "include": "#scene"
    },
    {
      "include": "#section"
    },
    {
      "include": "#character"
    },
    {
      "include": "#parenthetical"
    },
    {
      "include": "#centered"
    },
    {
      "include": "#dialog"
    },
    {
      "include": "#lyric"
    },
    {
      "include": "#transition"
    },
    {
      "include": "#pagebreak"
    },
    {
      "include": "#action"
    }
  ],
  "repository": {
    "frontmatter": {
      "begin": "(?:^|(?<=-->))[ \\t]*(---)(?=(?:[ \\t]|<!--(?:(?!-->).)*-->)*(?:<!--(?:(?!-->).)*)?$)",
      "end": "(?:^|(?<=-->))[ \\t]*(---)(?=(?:[ \\t]|<!--(?:(?!-->).)*-->)*(?:<!--(?:(?!-->).)*)?$)",
      "name": "meta.embedded.block.frontmatter.screenmark",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.tag.screenmark"
        }
      },
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.tag.screenmark"
        }
      },
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "begin": "(?:^|(?<=-->))[ \\t]*([A-Za-z][\\w ]*?)[ \\t]*(:)",
          "end": "(?=<!--)|$",
          "applyEndPatternLast": true,
          "contentName": "string.unquoted.screenmark",
          "beginCaptures": {
            "1": {
              "name": "entity.name.tag.screenmark"
            },
            "2": {
              "name": "punctuation.separator.key-value.screenmark"
            }
          },
          "patterns": [
            {
              "include": "#inline-comment"
            }
          ]
        }
      ]
    },
    "comment": {
      "begin": "<!--",
      "end": "-->",
      "name": "comment.block.html.screenmark"
    },
    "scene": {
      "begin": "(?:^|(?<=-->))[ \\t]*(##(?=[ \\t]))",
      "end": "(?=<!--)|$",
      "applyEndPatternLast": true,
      "name": "markup.heading.scene.screenmark",
      "contentName": "entity.name.function.scene-heading.screenmark",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.heading.screenmark"
        }
      },
      "patterns": [
        {
          "include": "#inline-comment"
        },
        {
          "begin": "[ \\t]+((?:<!--(?:(?!-->).)*-->[ \\t]*)*)(#)(?=[^#\\s])(?=(?:<!--(?:(?!-->).)*-->|(?!<!--)[^#])*#(?:[ \\t]|<!--(?:(?!-->).)*-->)*(?:<!--(?:(?!-->).)*)?$)",
          "end": "(#)|(?=<!--)|$",
          "applyEndPatternLast": true,
          "name": "constant.numeric.scene-number.screenmark",
          "patterns": [
            {
              "include": "#inline-comment"
            }
          ],
          "beginCaptures": {
            "1": {
              "patterns": [
                {
                  "include": "#inline-comment"
                }
              ]
            }
          }
        }
      ]
    },
    "section": {
      "begin": "(?:^|(?<=-->))[ \\t]*(#{1,6}(?=[ \\t]))",
      "end": "(?=<!--)|$",
      "applyEndPatternLast": true,
      "name": "markup.heading.section.screenmark",
      "contentName": "keyword.control.section.screenmark",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.heading.screenmark"
        }
      },
      "patterns": [
        {
          "include": "#inline-comment"
        }
      ]
    },
    "character": {
      "begin": "(?:^|(?<=-->))[ \\t]*(\\*\\*)(?=(?:<!--(?:(?!-->).)*-->|(?!<!--)[^*])+\\*\\*(?:[ \\t]|<!--(?:(?!-->).)*-->)*(?:\\^)?(?:[ \\t]|<!--(?:(?!-->).)*-->)*(?:<!--(?:(?!-->).)*)?$)",
      "end": "(?=<!--)|$",
      "applyEndPatternLast": true,
      "name": "markup.bold.character.screenmark",
      "contentName": "entity.name.class.character.screenmark",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.bold.screenmark"
        }
      },
      "patterns": [
        {
          "include": "#inline-comment"
        },
        {
          "match": "\\*\\*",
          "name": "punctuation.definition.bold.screenmark"
        },
        {
          "match": "\\^",
          "name": "keyword.operator.dual-dialog.screenmark"
        }
      ]
    },
    "parenthetical": {
      "begin": "(?:^|(?<=-->))[ \\t]*(_\\()(?=(?:<!--(?:(?!-->).)*-->|(?!<!--).)*\\)_(?:[ \\t]|<!--(?:(?!-->).)*-->)*(?:<!--(?:(?!-->).)*)?$)",
      "end": "(?=<!--)|$",
      "applyEndPatternLast": true,
      "name": "markup.italic.parenthetical.screenmark",
      "contentName": "support.constant.parenthetical.screenmark",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.italic.screenmark"
        }
      },
      "patterns": [
        {
          "include": "#inline-comment"
        },
        {
          "match": "\\)_",
          "name": "punctuation.definition.italic.screenmark"
        }
      ]
    },
    "centered": {
      "begin": "(?:^|(?<=-->))[ \\t]*(>)(?=(?:<!--(?:(?!-->).)*-->|(?!<!--).)*<(?:[ \\t]|<!--(?:(?!-->).)*-->)*(?:<!--(?:(?!-->).)*)?$)",
      "end": "(?=<!--)|$",
      "applyEndPatternLast": true,
      "name": "markup.quote.centered.screenmark",
      "contentName": "string.other.centered.screenmark",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.quote.screenmark"
        }
      },
      "patterns": [
        {
          "include": "#inline-comment"
        },
        {
          "match": "<(?=(?:[ \\t]|<!--(?:(?!-->).)*-->)*(?:<!--(?:(?!-->).)*)?$)",
          "name": "punctuation.definition.quote.screenmark"
        }
      ]
    },
    "dialog": {
      "begin": "(?:^|(?<=-->))[ \\t]*(>)",
      "end": "(?=<!--)|$",
      "applyEndPatternLast": true,
      "name": "markup.quote.dialog.screenmark",
      "contentName": "string.quoted.dialog.screenmark",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.quote.screenmark"
        }
      },
      "patterns": [
        {
          "include": "#inline-comment"
        }
      ]
    },
    "lyric": {
      "begin": "(?:^|(?<=-->))[ \\t]*(~)",
      "end": "(?=<!--)|$",
      "applyEndPatternLast": true,
      "name": "markup.italic.lyric.screenmark",
      "contentName": "string.quoted.lyric.screenmark",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.italic.screenmark"
        }
      },
      "patterns": [
        {
          "include": "#inline-comment"
        }
      ]
    },
    "transition": {
      "begin": "(?:^|(?<=-->))[ \\t]*(@)",
      "end": "(?=<!--)|$",
      "applyEndPatternLast": true,
      "name": "keyword.control.transition.screenmark",
      "contentName": "keyword.control.transition.text.screenmark",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.keyword.screenmark"
        }
      },
      "patterns": [
        {
          "include": "#inline-comment"
        }
      ]
    },
    "pagebreak": {
      "match": "(?:^|(?<=-->))[ \\t]*-{3,}(?=(?:[ \\t]|<!--(?:(?!-->).)*-->)*(?:<!--(?:(?!-->).)*)?$)",
      "name": "meta.separator.pagebreak.screenmark"
    },
    "document-start": {
      "comment": "Only leading comment-only lines may precede frontmatter. An authored blank or the first closing fence ends this initial state.",
      "begin": "\\A(?=[ \\t]*(?:<!--|---(?=(?:[ \\t]|<!--(?:(?!-->).)*-->)*(?:<!--(?:(?!-->).)*)?$)))",
      "end": "(?<=---)|(?=[ \\t]*(?!<!--|---(?=(?:[ \\t]|<!--(?:(?!-->).)*-->)*(?:<!--(?:(?!-->).)*)?$))\\S)|^[ \\t]*$",
      "patterns": [
        {
          "match": "[ \\t]+(?=<!--)"
        },
        {
          "include": "#comment"
        },
        {
          "include": "#frontmatter"
        }
      ]
    },
    "inline-comment": {
      "comment": "Keep closed same-line notes nested; unmatched openers end line scopes so the root comment owns multiline state.",
      "match": "<!--(?:(?!-->).)*-->",
      "name": "comment.block.html.screenmark"
    },
    "action": {
      "comment": "Keep inline notes inside plain action so a marker after a same-line note cannot become a new structural prefix.",
      "begin": "(?:^|(?<=-->))[ \\t]*(?!<!--)\\S",
      "end": "(?=<!--)|$",
      "applyEndPatternLast": true,
      "patterns": [
        {
          "include": "#inline-comment"
        }
      ]
    }
  }
}
