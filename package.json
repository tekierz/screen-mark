{
  "name": "screen-mark",
  "displayName": "ScreenMark",
  "description": "Write screenplays in markdown. Export real screenplay PDFs — then plan the shoot with breakdowns, schedules, and budgets.",
  "version": "0.3.1",
  "publisher": "tikilabs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tekierz/screen-mark.git"
  },
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#222630",
    "theme": "dark"
  },
  "keywords": [
    "screenplay",
    "screenwriting",
    "fountain",
    "film",
    "markdown"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Formatters",
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:screenmark"
  ],
  "contributes": {
    "languages": [
      {
        "id": "screenmark",
        "aliases": [
          "ScreenMark",
          "screenmark"
        ],
        "extensions": [
          ".smark"
        ],
        "filenamePatterns": [
          "*.screen.md"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "screenmark",
        "scopeName": "text.screenmark",
        "path": "./syntaxes/screenmark.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "screenmark",
        "path": "./snippets/screenmark.json"
      }
    ],
    "commands": [
      {
        "command": "screenmark.exportPdf",
        "title": "ScreenMark: Export PDF",
        "icon": "$(file-pdf)"
      },
      {
        "command": "screenmark.exportFountain",
        "title": "ScreenMark: Export Fountain",
        "icon": "$(export)"
      },
      {
        "command": "screenmark.openPreview",
        "title": "ScreenMark: Open Preview",
        "icon": "$(open-preview)"
      },
      {
        "command": "screenmark.numberScenes",
        "title": "ScreenMark: Number Scenes",
        "icon": "$(list-ordered)"
      },
      {
        "command": "screenmark.generateBreakdown",
        "title": "ScreenMark: Scene Breakdown",
        "icon": "$(checklist)"
      },
      {
        "command": "screenmark.generateSchedule",
        "title": "ScreenMark: Shooting Schedule",
        "icon": "$(calendar)"
      },
      {
        "command": "screenmark.initBudget",
        "title": "ScreenMark: Init Budget",
        "icon": "$(credit-card)"
      },
      {
        "command": "screenmark.budgetSummary",
        "title": "ScreenMark: Budget Summary",
        "icon": "$(symbol-number)"
      },
      {
        "command": "screenmark.refreshProject",
        "title": "ScreenMark: Refresh Project View",
        "icon": "$(refresh)"
      }
    ],
    "configuration": {
      "title": "ScreenMark",
      "properties": {
        "screenmark.pagesPerDay": {
          "type": "number",
          "default": 5,
          "minimum": 0.5,
          "description": "Target script pages per shooting day used by ScreenMark: Shooting Schedule."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "screenmark",
          "title": "ScreenMark",
          "icon": "media/activity-icon.svg"
        }
      ]
    },
    "views": {
      "screenmark": [
        {
          "id": "screenmarkActions",
          "name": "Actions"
        },
        {
          "id": "screenmarkProject",
          "name": "Film Project"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "screenmarkProject",
        "contents": "No screenplay files found.\nCreate a file ending in .screen.md or .smark to start a script, then generate breakdowns, schedules, and budgets from it."
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "screenmark.openPreview",
          "when": "editorLangId == screenmark",
          "group": "navigation@1"
        },
        {
          "command": "screenmark.exportPdf",
          "when": "editorLangId == screenmark",
          "group": "navigation@2"
        }
      ],
      "view/title": [
        {
          "command": "screenmark.refreshProject",
          "when": "view == screenmarkProject",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "screenmark.generateBreakdown",
          "when": "editorLangId == screenmark"
        },
        {
          "command": "screenmark.generateSchedule",
          "when": "editorLangId == screenmark"
        },
        {
          "command": "screenmark.exportPdf",
          "when": "editorLangId == screenmark"
        },
        {
          "command": "screenmark.exportFountain",
          "when": "editorLangId == screenmark"
        },
        {
          "command": "screenmark.openPreview",
          "when": "editorLangId == screenmark"
        },
        {
          "command": "screenmark.numberScenes",
          "when": "editorLangId == screenmark"
        }
      ]
    }
  },
  "scripts": {
    "build": "bun esbuild.js",
    "watch": "bun esbuild.js --watch",
    "typecheck": "tsc --noEmit",
    "test": "bun test ./test/*.test.ts",
    "verify": "bun run typecheck && bun run test && bun run build",
    "smoke": "bun scripts/editor-smoke.ts",
    "samples": "bun scripts/generate-samples.ts",
    "package": "bun scripts/release.ts"
  },
  "dependencies": {
    "pdfkit": "^0.15.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/pdfkit": "^0.13.4",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "3.9.2",
    "esbuild": "^0.21.0",
    "fountain-js": "1.2.4",
    "typescript": "^5.4.0",
    "vscode-oniguruma": "2.0.1",
    "vscode-textmate": "9.3.2"
  },
  "packageManager": "bun@1.3.11"
}
