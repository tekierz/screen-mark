{
  "comments": {
    "blockComment": ["<!--", "-->"]
  },
  "brackets": [
    ["(", ")"],
    ["[", "]"]
  ],
  "autoClosingPairs": [
    { "open": "(", "close": ")" },
    { "open": "[", "close": "]" },
    { "open": "**", "close": "**" },
    { "open": "_", "close": "_" },
    { "open": "<!--", "close": "-->" }
  ],
  "surroundingPairs": [
    ["(", ")"],
    ["*", "*"],
    ["_", "_"]
  ],
  "wordPattern": "[A-Za-z0-9''.-]+"
}
